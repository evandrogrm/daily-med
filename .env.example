# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongo:27017/dailymed

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# DailyMed API
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# Logging
LOG_LEVEL=info
