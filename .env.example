# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongo:27017/dailymed

# JWT (required — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS (comma-separated list of allowed origins, e.g. http://localhost:3001,https://myapp.com)
CORS_ORIGIN=http://localhost:3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# DailyMed API
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# Logging
LOG_LEVEL=info
