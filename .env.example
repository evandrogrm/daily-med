# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongo:27017/dailymed

# JWT (REQUIRED — do not use default placeholder values in production)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# DailyMed API
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000

# Docker credentials (override in .env for production)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
ME_BASICAUTH_USERNAME=admin
ME_BASICAUTH_PASSWORD=password

# Logging
LOG_LEVEL=info
